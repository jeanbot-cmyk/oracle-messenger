generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  googleId    String   @unique
  email       String   @unique
  name        String
  username    String   @unique
  avatar      String?
  status      String   @default("offline")
  lastSeen    DateTime?
  isPremium   Boolean  @default(false)
  premiumUntil DateTime?
  bio         String?
  phone       String?  @unique  // Format international nettoyé : +225XXXXXXXX
  phoneHash   String?  @unique
  phoneDigitsHash String?
  phoneLast8Hash  String?
  phoneLast9Hash  String?
  pushToken   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sentMessages     Message[]      @relation("SentMessages")
  participations   Participant[]
  aiMemories       AiMemory[]
  stories          Story[]
  storyViews       StoryView[]
  storyInteractions StoryInteraction[]
  callLogs         CallLog[]
  pwaInstall       PwaInstall?
  contacts         Contact[]     @relation("ContactOwner")
  contactedBy      Contact[]     @relation("ContactTarget")
  messageReactions MessageReaction[]
  aiAutoConfig     AiAutoConfig?
  aiWallet         AiWallet?
  aiPayments       AiPayment[]
  aiUsageLogs      AiUsageLog[]
  aiFlyerWallet    AiFlyerWallet?
  aiFlyerPayments  AiFlyerPayment[]
  aiFlyerGenerations AiFlyerGeneration[]
  aiVideoPayments  AiVideoPayment[]
  aiVideoGenerations AiVideoGeneration[]
  businessClients   BusinessClient[]   @relation("BusinessOwner")
  businessCustomerCards BusinessClient[] @relation("BusinessCustomer")
  businessReminders BusinessReminder[]
  businessSubscription BusinessSubscription?
  businessSubscriptionPayments BusinessSubscriptionPayment[]
  conferenceRooms ConferenceRoom[] @relation("ConferenceHost")
  conferenceSubscription ConferenceSubscription?
  conferencePayments ConferencePayment[]
  conferenceParticipations ConferenceParticipant[]
  conferenceQuestions ConferenceQuestion[]
  conferenceReactions ConferenceReaction[]
  conferencePollVotes ConferencePollVote[]
  conferenceDocuments ConferenceDocument[]
  conferenceAiSummaries ConferenceAiSummary[]
  conferenceBooks ConferenceBook[] @relation("ConferenceBookHost")
  conferenceBookPurchases ConferenceBookPurchase[]
  groupInvitationsReceived GroupInvitation[] @relation("GroupInvitedUser")
  groupInvitationsSent     GroupInvitation[] @relation("GroupInvitedBy")

  @@index([phoneDigitsHash])
  @@index([phoneLast8Hash])
  @@index([phoneLast9Hash])
}

model AiAutoConfig {
  id             String   @id @default(uuid())
  userId         String   @unique
  isEnabled      Boolean  @default(false)
  paidActive     Boolean  @default(false)
  prompt         String   @db.Text
  delayMs        Int      @default(5000)
  maxWords       Int      @default(30)
  recipientScope String   @default("private_only") // friends | non_friends | everyone | groups_only | private_only
  dailyLimit     Int?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiWallet {
  id              String   @id @default(uuid())
  userId          String   @unique
  wordsRemaining  Int      @default(0)
  wordsConsumed   Int      @default(0)
  valueRemainingFcfa Int   @default(0)
  totalResponses  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiPayment {
  id               String   @id @default(uuid())
  userId           String
  reference        String   @unique
  planCode         String
  amountFcfa       Int
  words            Int
  type             String   // activation | recharge
  status           String   @default("pending") // pending | success | failed
  authorizationUrl String?  @db.Text
  paidAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model AiUsageLog {
  id             String   @id @default(uuid())
  userId         String
  conversationId String?
  messageId      String?
  mode           String   @default("auto") // auto | test
  words          Int
  costFcfa       Int
  response       String   @db.Text
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([conversationId])
}

model AiPlan {
  id         String   @id @default(uuid())
  code       String   @unique
  label      String
  type       String   // activation | recharge
  priceFcfa  Int
  words      Int
  enabled    Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AiSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model BusinessClient {
  id             String   @id @default(uuid())
  ownerId        String
  customerUserId String?
  conversationId String?
  name           String
  phone          String?
  email          String?
  status         String   @default("prospect") // prospect | chaud | froid | paye | relancer | vip | perdu
  tags           String   @default("prospect")
  notes          String   @default("") @db.Text
  value          Int      @default(0)
  source         String   @default("manual") // manual | ai_auto | payment
  lastIntent     String?
  lastMessageAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner          User     @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  customer       User?    @relation("BusinessCustomer", fields: [customerUserId], references: [id], onDelete: SetNull)
  reminders      BusinessReminder[]

  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([ownerId, conversationId])
  @@index([ownerId, customerUserId])
}

model BusinessSubscription {
  id        String   @id @default(uuid())
  userId    String   @unique
  active    Boolean  @default(false)
  activeUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessSubscriptionPayment {
  id               String   @id @default(uuid())
  userId           String
  reference        String   @unique
  amountFcfa       Int
  months           Int      @default(1)
  status           String   @default("pending") // pending | success | failed
  authorizationUrl String?  @db.Text
  paidAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model BusinessReminder {
  id             String   @id @default(uuid())
  ownerId        String
  clientId       String?
  conversationId String?
  title          String
  note           String   @default("") @db.Text
  dueAt          DateTime
  done           Boolean  @default(false)
  source         String   @default("manual") // manual | ai_auto
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  client         BusinessClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([ownerId, dueAt])
  @@index([clientId])
}

model AiFlyerWallet {
  id               String   @id @default(uuid())
  userId           String   @unique
  creditsRemaining Int      @default(0)
  creditsPurchased Int      @default(0)
  creditsConsumed  Int      @default(0)
  totalGenerated   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiFlyerPayment {
  id               String   @id @default(uuid())
  userId           String
  reference        String   @unique
  amountFcfa       Int
  credits          Int
  status           String   @default("pending") // pending | success | failed
  authorizationUrl String?  @db.Text
  paidAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model AiFlyerGeneration {
  id          String   @id @default(uuid())
  userId      String
  prompt      String   @db.Text
  mode        String   @default("paid") // free | paid
  status      String   @default("COMPLETED") // QUEUED | PROCESSING | COMPLETED | DOWNLOADABLE | FAILED
  mime        String?
  imageBytes  Int?
  imageHash   String?
  fileUrl     String?  @db.Text
  downloadUrl String?  @db.Text
  filePath    String?
  fileName    String?
  title       String?
  completedAt DateTime?
  failedAt    DateTime?
  expiresAt   DateTime?
  downloadedAt DateTime?
  purgedAt    DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model AiVideoPayment {
  id               String   @id @default(uuid())
  userId           String
  reference        String   @unique
  amountFcfa       Int
  durationSeconds  Int
  status           String   @default("pending") // pending | success | failed
  authorizationUrl String?  @db.Text
  paidAt           DateTime?
  consumedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model AiVideoGeneration {
  id              String   @id @default(uuid())
  userId          String
  prompt          String   @db.Text
  mode            String   @default("premium") // free | premium | admin
  status          String   @default("COMPLETED") // QUEUED | PROCESSING | COMPLETED | DOWNLOADABLE | FAILED
  mime            String?
  videoBytes      Int?
  videoHash       String?
  fileUrl         String?  @db.Text
  downloadUrl     String?  @db.Text
  filePath        String?
  fileName        String?
  durationSeconds Int
  aspectRatio     String
  quality         String
  referenceCount  Int      @default(0)
  title           String?
  completedAt     DateTime?
  failedAt        DateTime?
  expiresAt       DateTime?
  downloadedAt    DateTime?
  purgedAt        DateTime?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model Contact {
  id            String   @id @default(uuid())
  ownerId       String
  contactUserId String
  source        String   @default("phone_import") // phone_import | invite_link | conversation
  displayName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner         User     @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contactUser   User     @relation("ContactTarget", fields: [contactUserId], references: [id], onDelete: Cascade)

  @@unique([ownerId, contactUserId])
  @@index([ownerId])
  @@index([contactUserId])
}

model PwaInstall {
  id          String   @id @default(uuid())
  userId      String   @unique
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userAgent   String?  @db.Text

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Historique des appels persisté en base
model CallLog {
  id             String   @id @default(uuid())
  callId         String   // identifiant de session WebRTC
  userId         String   // utilisateur concerné par cette entrée
  peerId         String   // l'autre participant
  peerName       String
  type           String   // audio | video
  direction      String   // incoming | outgoing | missed
  duration       Int?     // secondes, null si manqué/refusé
  startedAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt(sort: Desc)])
}

model Conversation {
  id           String   @id @default(uuid())
  type         String   @default("direct") // direct | group
  name         String?
  avatar       String?
  description  String?  @db.Text
  messagePolicy String  @default("ALL_PARTICIPANTS") // ALL_PARTICIPANTS | ADMINS_ONLY
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participants Participant[]
  messages     Message[]
  invitations  GroupInvitation[]
}

model Participant {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  role           String       @default("member") // admin | member
  canSendMessages Boolean     @default(true)

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId])
  @@index([userId, lastReadAt])
}

model GroupInvitation {
  id             String       @id @default(uuid())
  conversationId String
  invitedUserId  String
  invitedById    String
  status         String       @default("PENDING") // INVITED | PENDING | ACCEPTED | DECLINED | REMOVED | LEFT
  respondedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  invitedUser    User         @relation("GroupInvitedUser", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation("GroupInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([conversationId, invitedUserId])
  @@index([invitedUserId, status])
  @@index([conversationId, status])
  @@index([invitedById])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  clientMessageId String?
  content        String   @db.Text
  type           String   @default("text")
  status         String   @default("sent")
  replyToId      String?
  isDeleted      Boolean  @default(false)
  isEdited       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  replyTo        Message?     @relation("Replies", fields: [replyToId], references: [id])
  replies        Message[]    @relation("Replies")
  localSaves     MessageLocalSave[]
  reactions      MessageReaction[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, senderId, createdAt(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
  @@index([replyToId])
  @@unique([senderId, clientMessageId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model MessageLocalSave {
  id             String   @id @default(uuid())
  messageId      String
  userId         String
  checksum       String?
  size           Int?
  deliveryState  String   @default("UPLOADED")
  downloadedAt   DateTime?
  locallySavedAt DateTime?
  ackConfirmedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  message        Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model ConferenceSubscription {
  id          String    @id @default(uuid())
  userId      String    @unique
  planCode    String    @default("conference_50_70m")
  capacity    Int       @default(50)
  activeUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConferencePayment {
  id               String    @id @default(uuid())
  userId           String
  reference        String    @unique
  planCode         String
  amountFcfa       Int
  capacity         Int
  months           Int       @default(0)
  durationMinutes  Int       @default(70)
  status           String    @default("pending")
  authorizationUrl String?
  paidAt           DateTime?
  downloadedAt     DateTime?
  purgedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model ConferenceRoom {
  id                   String                  @id @default(uuid())
  hostId               String
  slug                 String                  @unique
  title                String
  description          String?
  phone                String?
  contactInfo          String?
  coverUrl             String?
  speakerName          String?
  scheduledAt          DateTime?
  durationMinutes      Int                     @default(70)
  logoUrl              String?
  visualIdentity       String?
  sourceMode           String                  @default("camera")
  prerecordedLocalName String?
  status               String                  @default("draft")
  planCode             String                  @default("conference_50_70m")
  capacity             Int                     @default(50)
  aiWordLimit          Int                     @default(3500)
  aiWordsUsed          Int                     @default(0)
  livekitRoom          String                  @unique
  startedAt            DateTime?
  endedAt              DateTime?
  expiresAt            DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  host                 User                    @relation("ConferenceHost", fields: [hostId], references: [id], onDelete: Cascade)
  participants         ConferenceParticipant[]
  questions            ConferenceQuestion[]
  reactions            ConferenceReaction[]
  polls                ConferencePoll[]
  documents            ConferenceDocument[]
  aiSummaries          ConferenceAiSummary[]
  book                 ConferenceBook?

  @@index([hostId, updatedAt(sort: Desc)])
  @@index([status])
}

model ConferenceParticipant {
  id         String         @id @default(uuid())
  roomId     String
  userId     String
  role       String         @default("viewer")
  handStatus String         @default("none")
  handRaisedAt DateTime?
  micAllowed Boolean        @default(false)
  micAllowedAt DateTime?
  joinedAt   DateTime       @default(now())
  lastSeenAt DateTime       @default(now())
  leftAt     DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  room       ConferenceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, leftAt, lastSeenAt])
  @@index([roomId, handStatus, handRaisedAt])
}

model ConferenceQuestion {
  id         String         @id @default(uuid())
  roomId     String
  userId     String
  content    String         @db.Text
  answer     String?        @db.Text
  isPinned   Boolean        @default(false)
  isAnswered Boolean        @default(false)
  isDeleted  Boolean        @default(false)
  priority   Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  room       ConferenceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt(sort: Desc)])
}

model ConferenceReaction {
  id        String         @id @default(uuid())
  roomId    String
  userId    String
  emoji     String
  createdAt DateTime       @default(now())

  room      ConferenceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt(sort: Desc)])
}

model ConferencePoll {
  id          String               @id @default(uuid())
  roomId      String
  question    String
  options     String               @db.Text
  showResults Boolean              @default(true)
  status      String               @default("open")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  room        ConferenceRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  votes       ConferencePollVote[]

  @@index([roomId, createdAt(sort: Desc)])
}

model ConferencePollVote {
  id          String         @id @default(uuid())
  pollId      String
  userId      String
  optionIndex Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  poll        ConferencePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model ConferenceDocument {
  id        String         @id @default(uuid())
  roomId    String
  userId    String
  title     String
  url       String?
  mime      String?
  kind      String         @default("link")
  createdAt DateTime       @default(now())

  room      ConferenceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt(sort: Desc)])
}

model ConferenceAiSummary {
  id         String         @id @default(uuid())
  roomId     String
  userId     String
  promptType String
  content    String         @db.Text
  createdAt  DateTime       @default(now())

  room       ConferenceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConferenceBook {
  id        String   @id @default(uuid())
  roomId    String   @unique
  hostId    String
  title     String
  content   String   @db.Text
  preview   String   @db.Text
  pdfUrl    String?
  pageCount Int      @default(1)
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room      ConferenceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  host      User           @relation("ConferenceBookHost", fields: [hostId], references: [id], onDelete: Cascade)
  purchases ConferenceBookPurchase[]

  @@index([roomId, status])
}

model ConferenceBookPurchase {
  id               String    @id @default(uuid())
  bookId           String
  userId           String
  reference        String    @unique
  amountFcfa       Int       @default(2000)
  status           String    @default("pending")
  authorizationUrl String?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  book             ConferenceBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

// Stories — visibles 24h, partagées entre utilisateurs
model Story {
  id          String   @id @default(uuid())
  authorId    String
  content     String   @db.Text  // base64 image ou texte
  caption     String?
  type        String   @default("text") // text | image
  bg          String   @default("#128C7E")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  views       StoryView[]
  interactions StoryInteraction[]
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, expiresAt, createdAt(sort: Desc)])
  @@index([expiresAt, createdAt(sort: Desc)])
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  viewedAt  DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([storyId, userId])
  @@index([userId, storyId])
  @@index([storyId, viewedAt(sort: Desc)])
}

model StoryInteraction {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  type      String
  content   String?  @db.Text
  emoji     String?
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@unique([storyId, userId, type, emoji])
}

// Mémoire IA — 7 jours conversations, 1 mois global
model AiMemory {
  id        String   @id @default(uuid())
  userId    String
  type      String   // conversation | global
  content   String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
