generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  googleId    String   @unique
  email       String   @unique
  name        String
  username    String   @unique
  avatar      String?
  status      String   @default("offline")
  lastSeen    DateTime?
  isPremium   Boolean  @default(false)
  premiumUntil DateTime?
  bio         String?
  phone       String?  @unique  // Format international nettoyé : +225XXXXXXXX
  phoneHash   String?  @unique
  phoneDigitsHash String?
  phoneLast8Hash  String?
  phoneLast9Hash  String?
  pushToken   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sentMessages     Message[]      @relation("SentMessages")
  participations   Participant[]
  aiMemories       AiMemory[]
  stories          Story[]
  storyViews       StoryView[]
  callLogs         CallLog[]
  pwaInstall       PwaInstall?
  contacts         Contact[]     @relation("ContactOwner")
  contactedBy      Contact[]     @relation("ContactTarget")
  messageReactions MessageReaction[]
  aiAutoConfig     AiAutoConfig?
  aiWallet         AiWallet?
  aiPayments       AiPayment[]
  aiUsageLogs      AiUsageLog[]
  aiFlyerWallet    AiFlyerWallet?
  aiFlyerPayments  AiFlyerPayment[]
  aiFlyerGenerations AiFlyerGeneration[]
  aiVideoPayments  AiVideoPayment[]
  aiVideoGenerations AiVideoGeneration[]
  businessClients   BusinessClient[]   @relation("BusinessOwner")
  businessCustomerCards BusinessClient[] @relation("BusinessCustomer")
  businessReminders BusinessReminder[]
  businessSubscription BusinessSubscription?
  businessSubscriptionPayments BusinessSubscriptionPayment[]

  @@index([phoneDigitsHash])
  @@index([phoneLast8Hash])
  @@index([phoneLast9Hash])
}

model AiAutoConfig {
  id             String   @id @default(uuid())
  userId         String   @unique
  isEnabled      Boolean  @default(false)
  paidActive     Boolean  @default(false)
  prompt         String   @db.Text
  delayMs        Int      @default(5000)
  recipientScope String   @default("private_only") // friends | non_friends | everyone | groups_only | private_only
  dailyLimit     Int?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiWallet {
  id              String   @id @default(uuid())
  userId          String   @unique
  wordsRemaining  Int      @default(0)
  wordsConsumed   Int      @default(0)
  valueRemainingFcfa Int   @default(0)
  totalResponses  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiPayment {
  id               String   @id @default(uuid())
  userId           String
  reference        String   @unique
  planCode         String
  amountFcfa       Int
  words            Int
  type             String   // activation | recharge
  status           String   @default("pending") // pending | success | failed
  authorizationUrl String?  @db.Text
  paidAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model AiUsageLog {
  id             String   @id @default(uuid())
  userId         String
  conversationId String?
  messageId      String?
  mode           String   @default("auto") // auto | test
  words          Int
  costFcfa       Int
  response       String   @db.Text
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([conversationId])
}

model AiPlan {
  id         String   @id @default(uuid())
  code       String   @unique
  label      String
  type       String   // activation | recharge
  priceFcfa  Int
  words      Int
  enabled    Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AiSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model BusinessClient {
  id             String   @id @default(uuid())
  ownerId        String
  customerUserId String?
  conversationId String?
  name           String
  phone          String?
  email          String?
  status         String   @default("prospect") // prospect | chaud | froid | paye | relancer | vip | perdu
  tags           String   @default("prospect")
  notes          String   @default("") @db.Text
  value          Int      @default(0)
  source         String   @default("manual") // manual | ai_auto | payment
  lastIntent     String?
  lastMessageAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner          User     @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  customer       User?    @relation("BusinessCustomer", fields: [customerUserId], references: [id], onDelete: SetNull)
  reminders      BusinessReminder[]

  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([ownerId, conversationId])
  @@index([ownerId, customerUserId])
}

model BusinessSubscription {
  id        String   @id @default(uuid())
  userId    String   @unique
  active    Boolean  @default(false)
  activeUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessSubscriptionPayment {
  id               String   @id @default(uuid())
  userId           String
  reference        String   @unique
  amountFcfa       Int
  months           Int      @default(1)
  status           String   @default("pending") // pending | success | failed
  authorizationUrl String?  @db.Text
  paidAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model BusinessReminder {
  id             String   @id @default(uuid())
  ownerId        String
  clientId       String?
  conversationId String?
  title          String
  note           String   @default("") @db.Text
  dueAt          DateTime
  done           Boolean  @default(false)
  source         String   @default("manual") // manual | ai_auto
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  client         BusinessClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([ownerId, dueAt])
  @@index([clientId])
}

model AiFlyerWallet {
  id               String   @id @default(uuid())
  userId           String   @unique
  creditsRemaining Int      @default(0)
  creditsPurchased Int      @default(0)
  creditsConsumed  Int      @default(0)
  totalGenerated   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiFlyerPayment {
  id               String   @id @default(uuid())
  userId           String
  reference        String   @unique
  amountFcfa       Int
  credits          Int
  status           String   @default("pending") // pending | success | failed
  authorizationUrl String?  @db.Text
  paidAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model AiFlyerGeneration {
  id          String   @id @default(uuid())
  userId      String
  prompt      String   @db.Text
  mode        String   @default("paid") // free | paid
  mime        String?
  imageBytes  Int?
  imageHash   String?
  title       String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model AiVideoPayment {
  id               String   @id @default(uuid())
  userId           String
  reference        String   @unique
  amountFcfa       Int
  durationSeconds  Int
  status           String   @default("pending") // pending | success | failed
  authorizationUrl String?  @db.Text
  paidAt           DateTime?
  consumedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model AiVideoGeneration {
  id              String   @id @default(uuid())
  userId          String
  prompt          String   @db.Text
  mode            String   @default("premium") // free | premium | admin
  mime            String?
  videoBytes      Int?
  videoHash       String?
  durationSeconds Int
  aspectRatio     String
  quality         String
  referenceCount  Int      @default(0)
  title           String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model Contact {
  id            String   @id @default(uuid())
  ownerId       String
  contactUserId String
  source        String   @default("phone_import") // phone_import | invite_link | conversation
  displayName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner         User     @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contactUser   User     @relation("ContactTarget", fields: [contactUserId], references: [id], onDelete: Cascade)

  @@unique([ownerId, contactUserId])
  @@index([ownerId])
  @@index([contactUserId])
}

model PwaInstall {
  id          String   @id @default(uuid())
  userId      String   @unique
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userAgent   String?  @db.Text

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Historique des appels persisté en base
model CallLog {
  id             String   @id @default(uuid())
  callId         String   // identifiant de session WebRTC
  userId         String   // utilisateur concerné par cette entrée
  peerId         String   // l'autre participant
  peerName       String
  type           String   // audio | video
  direction      String   // incoming | outgoing | missed
  duration       Int?     // secondes, null si manqué/refusé
  startedAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt(sort: Desc)])
}

model Conversation {
  id           String   @id @default(uuid())
  type         String   @default("direct") // direct | group
  name         String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participants Participant[]
  messages     Message[]
}

model Participant {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String   @db.Text
  type           String   @default("text")
  status         String   @default("sent")
  replyToId      String?
  isDeleted      Boolean  @default(false)
  isEdited       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  replyTo        Message?     @relation("Replies", fields: [replyToId], references: [id])
  replies        Message[]    @relation("Replies")
  localSaves     MessageLocalSave[]
  reactions      MessageReaction[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, senderId, createdAt(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
  @@index([replyToId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model MessageLocalSave {
  id             String   @id @default(uuid())
  messageId      String
  userId         String
  checksum       String?
  size           Int?
  deliveryState  String   @default("UPLOADED")
  downloadedAt   DateTime?
  locallySavedAt DateTime?
  ackConfirmedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  message        Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

// Stories — visibles 24h, partagées entre utilisateurs
model Story {
  id          String   @id @default(uuid())
  authorId    String
  content     String   @db.Text  // base64 image ou texte
  caption     String?
  type        String   @default("text") // text | image
  bg          String   @default("#128C7E")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  views       StoryView[]
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  viewedAt  DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([storyId, userId])
}

// Mémoire IA — 7 jours conversations, 1 mois global
model AiMemory {
  id        String   @id @default(uuid())
  userId    String
  type      String   // conversation | global
  content   String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
