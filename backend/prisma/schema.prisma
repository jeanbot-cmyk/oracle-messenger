generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  googleId    String   @unique
  email       String   @unique
  name        String
  username    String   @unique
  avatar      String?
  status      String   @default("offline")
  lastSeen    DateTime?
  isPremium   Boolean  @default(false)
  premiumUntil DateTime?
  bio         String?
  phone       String?  @unique  // Format international nettoyé : +225XXXXXXXX
  phoneHash   String?  @unique
  phoneDigitsHash String?
  phoneLast8Hash  String?
  phoneLast9Hash  String?
  pushToken   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sentMessages     Message[]      @relation("SentMessages")
  participations   Participant[]
  aiMemories       AiMemory[]
  stories          Story[]
  storyViews       StoryView[]
  callLogs         CallLog[]
  pwaInstall       PwaInstall?
  contacts         Contact[]     @relation("ContactOwner")
  contactedBy      Contact[]     @relation("ContactTarget")
  messageReactions MessageReaction[]

  @@index([phoneDigitsHash])
  @@index([phoneLast8Hash])
  @@index([phoneLast9Hash])
}

model Contact {
  id            String   @id @default(uuid())
  ownerId       String
  contactUserId String
  source        String   @default("phone_import") // phone_import | invite_link | conversation
  displayName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner         User     @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contactUser   User     @relation("ContactTarget", fields: [contactUserId], references: [id], onDelete: Cascade)

  @@unique([ownerId, contactUserId])
  @@index([ownerId])
  @@index([contactUserId])
}

model PwaInstall {
  id          String   @id @default(uuid())
  userId      String   @unique
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userAgent   String?  @db.Text

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Historique des appels persisté en base
model CallLog {
  id             String   @id @default(uuid())
  callId         String   // identifiant de session WebRTC
  userId         String   // utilisateur concerné par cette entrée
  peerId         String   // l'autre participant
  peerName       String
  type           String   // audio | video
  direction      String   // incoming | outgoing | missed
  duration       Int?     // secondes, null si manqué/refusé
  startedAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt(sort: Desc)])
}

model Conversation {
  id           String   @id @default(uuid())
  type         String   @default("direct") // direct | group
  name         String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participants Participant[]
  messages     Message[]
}

model Participant {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String   @db.Text
  type           String   @default("text")
  status         String   @default("sent")
  replyToId      String?
  isDeleted      Boolean  @default(false)
  isEdited       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  replyTo        Message?     @relation("Replies", fields: [replyToId], references: [id])
  replies        Message[]    @relation("Replies")
  localSaves     MessageLocalSave[]
  reactions      MessageReaction[]
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model MessageLocalSave {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  checksum  String?
  size      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

// Stories — visibles 24h, partagées entre utilisateurs
model Story {
  id          String   @id @default(uuid())
  authorId    String
  content     String   @db.Text  // base64 image ou texte
  caption     String?
  type        String   @default("text") // text | image
  bg          String   @default("#128C7E")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  views       StoryView[]
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  viewedAt  DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([storyId, userId])
}

// Mémoire IA — 7 jours conversations, 1 mois global
model AiMemory {
  id        String   @id @default(uuid())
  userId    String
  type      String   // conversation | global
  content   String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
