# Base de données
POSTGRES_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql://oracle:changeme_strong_password@postgres:5432/oracle_messenger

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=changeme_jwt_secret_very_long_random_string

# NextAuth
NEXTAUTH_URL=https://messenger.oracle-plus.online
NEXTAUTH_SECRET=changeme_nextauth_secret

# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# URLs
FRONTEND_URL=https://messenger.oracle-plus.online
BACKEND_URL=https://api-messenger.oracle-plus.online
NEXT_PUBLIC_BACKEND_URL=https://api-messenger.oracle-plus.online

# Médias envoyés en conversation
MEDIA_UPLOAD_DIR=/app/uploads
MEDIA_UPLOAD_MAX_BYTES=18874368
PUBLIC_MEDIA_BASE_URL=https://api-messenger.oracle-plus.online

# WebRTC TURN privé recommandé en production
# Exemple: turn:votre-domaine:3478,turns:votre-domaine:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# SFU LiveKit — nécessaire pour appels de groupe scalables (>10-20 participants)
# Exemple URL: wss://livekit.oracle-plus.online
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Firebase Cloud Messaging natif Android
# Mettre aussi le fichier frontend/android/app/google-services.json côté build Android.
# Côté serveur, fournir soit FIREBASE_SERVICE_ACCOUNT_JSON, soit GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# VAPID (générer avec: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=BOdAVHML9EFXBnZpwUJwLVtmlNACJsgEXKKwdF39qMIbQopSusGjazHt-2Lgw4A2Jq3b-aeTxk6vi92XndL5cZA
VAPID_PRIVATE_KEY=3qD7YYcWFIdfUyiW6tqyhZS0FkDivwsxagPrYZix_GY

# OpenAI
OPENAI_API_KEY=sk-your_openai_key

# Gemini / Google AI Studio
GEMINI_API_KEY=AIza-your_gemini_key
GOOGLE_GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=veo-2.0-generate-001

# Paystack
PAYSTACK_SECRET_KEY=sk_test_or_live_your_paystack_secret_key
PAYSTACK_CURRENCY=XOF
