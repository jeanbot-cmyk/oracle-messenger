# Base de données
POSTGRES_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql://oracle:changeme_strong_password@postgres:5432/oracle_messenger

# Redis
REDIS_URL=redis://redis:6379
# Mode strict : refuse les chemins temps réel fragiles au lieu de dégrader silencieusement.
ORACLE_STRICT_REALTIME=true
# Exige aussi que les endpoints publics API/LiveKit/TURN soient réellement joignables.
REQUIRE_PUBLIC_NETWORK_READY=true

# JWT
JWT_SECRET=changeme_jwt_secret_very_long_random_string

# NextAuth
NEXTAUTH_URL=https://messenger.oracle-plus.online
NEXTAUTH_SECRET=changeme_nextauth_secret

# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# URLs
FRONTEND_URL=https://messenger.oracle-plus.online
BACKEND_URL=https://api-messenger.oracle-plus.online
NEXT_PUBLIC_BACKEND_URL=https://api-messenger.oracle-plus.online

# Médias envoyés en conversation
MEDIA_UPLOAD_DIR=/app/uploads
JSON_LIMIT=150mb
PUBLIC_MEDIA_BASE_URL=https://api-messenger.oracle-plus.online

# WebRTC TURN privé recommandé en production
# Exemple: turns:turn.180-149-196-5.sslip.io:443?transport=tcp,turn:turn.oracle-plus.online:3478?transport=udp
TURN_REALM=oracle-messenger
TURN_PUBLIC_IP=180.149.196.5
TURN_URLS=turns:turn.180-149-196-5.sslip.io:443?transport=tcp,turn:turn.oracle-plus.online:3478?transport=udp,turn:turn.oracle-plus.online:3478?transport=tcp
TURN_USERNAME=oracle_turn_user
TURN_CREDENTIAL=replace_with_secure_turn_password
# true si Traefik/Caddy termine le TLS 443 puis relaie en TCP vers coturn.
TURN_TLS_TERMINATED_BY_PROXY=true
TURN_TLS_DIR_HOST_PATH=/etc/letsencrypt/live/turn.oracle-plus.online
TURN_TLS_CERT_HOST_PATH=/etc/letsencrypt/live/turn.oracle-plus.online/fullchain.pem
TURN_TLS_KEY_HOST_PATH=/etc/letsencrypt/live/turn.oracle-plus.online/privkey.pem
# Uniquement pour tests. En production, utiliser un TURN privé.
ALLOW_PUBLIC_TURN_FALLBACK=false

# SFU LiveKit — nécessaire pour appels de groupe scalables (>10-20 participants)
# Exemple URL: wss://livekit.oracle-plus.online
LIVEKIT_URL=wss://livekit.oracle-plus.online
LIVEKIT_PUBLIC_IP=180.149.196.5
LIVEKIT_API_KEY=oracle_livekit_key
LIVEKIT_API_SECRET=replace_with_secure_livekit_secret
LIVEKIT_UDP_START=50000
LIVEKIT_UDP_END=50100
LIVEKIT_TURN_HOST=turn.180-149-196-5.sslip.io
LIVEKIT_TURN_PORT=443
LIVEKIT_TURN_PROTOCOL=tls
CALL_NO_ANSWER_TIMEOUT_MS=300000
MAX_AUDIO_CALL_PARTICIPANTS=100
MAX_VIDEO_CALL_PARTICIPANTS=10

# Salle de conférence — diffusion hôte -> LiveKit/SFU -> spectateurs
CONFERENCE_PUBLIC_URL=https://messenger.oracle-plus.online
ORACLE_MAIN_ADMIN_EMAILS=tchingankonggeorges@gmail.com,tchingangankonggeorges@gmail.com
ORACLE_MAIN_ADMIN_PHONES=+2250504673829,+2250700508618

# Firebase Cloud Messaging natif Android
# Mettre aussi le fichier frontend/android/app/google-services.json côté build Android.
# Côté serveur, fournir soit FIREBASE_SERVICE_ACCOUNT_JSON, soit GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_ADMIN_HOST_PATH=./.secrets/firebase-admin.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json

# VAPID (générer avec: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=BOdAVHML9EFXBnZpwUJwLVtmlNACJsgEXKKwdF39qMIbQopSusGjazHt-2Lgw4A2Jq3b-aeTxk6vi92XndL5cZA
VAPID_PRIVATE_KEY=3qD7YYcWFIdfUyiW6tqyhZS0FkDivwsxagPrYZix_GY

# OpenAI
OPENAI_API_KEY=sk-your_openai_key

# Gemini / Google AI Studio
GEMINI_API_KEY=AIza-your_gemini_key
GOOGLE_GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=veo-2.0-generate-001

# Paystack
PAYSTACK_SECRET_KEY=sk_test_or_live_your_paystack_secret_key
PAYSTACK_CURRENCY=XOF
